# ORCA Rehab website
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, set these in Project Settings → Environment Variables.
# Neither is NEXT_PUBLIC_, so neither ever reaches the browser.

# ORCA Careers API (Cloud Run) — receives job applications.
# Local development: http://localhost:8080 (run the API with `npm run dev` in ORCA_Careers_API).
CAREERS_API_URL=
# SECRET. Must equal WEBSITE_API_KEY in the Careers API.
CAREERS_API_KEY=
